# Discosweb Visualizer — Environment Variables
# 复制为 .env 后按需修改;docker-compose 会自动读取 .env(env_file 指令)
#
# 注意:所有变量都带 APP_ 前缀,这是 Pydantic Settings 的 env_prefix 配置。
# compose 中直接设置的环境变量也必须保留 APP_ 前缀(已修 F-07)。

# CORS 白名单(JSON 数组格式,Pydantic 自动解析)
APP_CORS_ORIGINS=["http://localhost:5173"]

# R1 / F-13 修复:运行时数据路径(可写)
# 对应容器内 /app/data/runtime/(命名卷 db-data)
# 样本数据在 /app/data/sample/(只读 bind mount)
APP_STORAGE_DIR=./data/runtime
APP_DUCKDB_PATH=./data/runtime/visualizer.duckdb

# M2: 看板持久化(独立 SQLite,与 DuckDB 分离)
APP_DASHBOARD_DB_PATH=./data/runtime/dashboards.sqlite

# 应用名(可选)
APP_APP_NAME=discosweb-visualizer
